# ─────────────────────────────────────────────────────────────
# Beej Gatha — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── EmailJS (contact form) ────────────────────────────────────
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# ── Contact / WhatsApp ────────────────────────────────────────
VITE_WHATSAPP_NUMBER=91XXXXXXXXXX
VITE_PHONE_DISPLAY=+91 XXXXX XXXXX
VITE_PHONE_TEL=+91XXXXXXXXXX
VITE_MAPS_QUERY=YourCity

# ── Business info ─────────────────────────────────────────────
VITE_BUSINESS_EMAIL=hello@yourdomain.com
VITE_BUSINESS_PHONE_DISPLAY=+91 XXXXX XXXXX
VITE_BUSINESS_PHONE_TEL=+91XXXXXXXXXX

# ── Office addresses ──────────────────────────────────────────
VITE_OFFICE_ADDRESS=Your Office Address Here
VITE_PROCESSING_HUB=Your Processing Hub Name
VITE_DISTRIBUTION_CENTER=Your Distribution Center Name

# ── LocalStorage key ─────────────────────────────────────────
VITE_STORAGE_KEY=beej_gatha_inventory

# ── GSAP CDN ─────────────────────────────────────────────────
VITE_GSAP_CDN=https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js
VITE_SCROLLTRIGGER_CDN=https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js
